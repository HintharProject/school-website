# ==============================================================================
# HINTHAR INTERNATIONAL SCHOOL — ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to .env.local (for Next.js dev) and .dev.vars (for Cloudflare Wrangler local).
# In production, set secrets using `npx wrangler secret put <KEY>`.

# 1. Better Auth Session & Security Configuration
BETTER_AUTH_SECRET="your-32-byte-base64-random-secret-here"
BETTER_AUTH_URL="http://localhost:3000"

# 2. Master School Administrator Initial Account
# Used only during initial bootstrap synchronization.
INITIAL_ADMIN_EMAIL="admin@hinthar.education"
INITIAL_ADMIN_PASSWORD="YourStrongAdminPassword123!"
INITIAL_ADMIN_NAME="ThawYeZaw"

# 3. Administrative Bootstrap Endpoint Token
# Header 'x-admin-bootstrap-secret' required to invoke /api/admin/bootstrap
ADMIN_BOOTSTRAP_SECRET="your-random-bootstrap-secret-token"

# 4. Resend Transactional Email Dispatcher
RESEND_API_KEY="re_123456789_abcdef"
RESEND_FROM="Hinthar Admissions <admissions@hinthar.education>"

# 5. Public Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
