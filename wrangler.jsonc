{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hinthar",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-08-17",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"vars": {
		"BETTER_AUTH_URL": "https://hinthar.thawyezaw.workers.dev"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "hinthar"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hinthar-db",
			"database_id": "ac7a8278-fbd7-49e9-bf1b-a20a11707f96",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "R2",
			"bucket_name": "hinthar-assets"
		}
	],
	"observability": {
		"enabled": true
	}
}